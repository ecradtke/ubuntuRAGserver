# ==============================================================================
# K13 AI Stack (Ubuntu Server, native OpenVINO - no containers) - configuration template
# Copy to '.env' in the repo root (chmod 600) and fill in real values.
# This file is parsed (never executed) by the scripts in scripts/, so:
#   - put comments on their OWN line (no trailing "# comment" after a value)
#   - quote values that contain spaces or special characters: PG_PASS="my pass"
# ==============================================================================

# --- Network ---
NAS_HOST=192.168.4.22

# --- Data folders (created by scripts/install.sh) ---
K13_DATA_DIR=/var/lib/k13
# OpenVINO models (downloaded LLM + embedding model + compile cache)
OV_MODELS_DIR=/var/lib/k13/openvino
QDRANT_STORAGE_DIR=/var/lib/k13/qdrant/storage
QDRANT_SNAPSHOTS_DIR=/var/lib/k13/qdrant/snapshots

# --- OpenVINO server: chat LLM on the Intel GPU, embeddings on the Intel NPU ---
# Python that has OpenVINO + openvino-genai installed. Blank = create .venv-openvino inside this project
OPENVINO_PYTHON=
# Optional script sourced before the server starts (e.g. /opt/intel/openvino/setupvars.sh)
OPENVINO_SETUPVARS=
# Hugging Face repo of the pre-converted OpenVINO LLM (downloaded automatically on first start)
DEFAULT_MODEL=OpenVINO/Qwen3-8B-int4-ov
# Embedding model. BGE Base (768 dims) is the default. Must match your Qdrant collection;
# the RSS sync recreates and re-indexes the collection automatically if the dimension changes.
# scripts/install.sh resets this to BGE Base on every run (use --keep-embed-model to keep another value).
EMBED_MODEL=BAAI/bge-base-en-v1.5
LLM_DEVICE=GPU
EMBED_DEVICE=NPU
# off = reasoning models (Qwen3) answer directly, on = allow hidden <think> reasoning
LLM_THINKING=off
MAX_NEW_TOKENS=2048
# off = a model switch that only fits on the CPU is rolled back, on = allow slow CPU fallback
SWITCH_ALLOW_CPU=off
# 127.0.0.1 = this server only, 0.0.0.0 = whole LAN
OV_HOST=127.0.0.1
OV_PORT=11434
HF_TOKEN=

# --- Qdrant (native binary) ---
QDRANT_PORT=6333
# 0.0.0.0 = reachable from your LAN (dashboard at http://<server>:6333/dashboard), 127.0.0.1 = this server only
QDRANT_BIND=0.0.0.0
QDRANT_COLLECTION=rss_articles

# --- FreshRSS API (NAS) ---
FRESHRSS_BASE_URL=http://192.168.4.22:9801
FRESHRSS_USER=your_freshrss_username
FRESHRSS_API_PASS="your_freshrss_api_password"

# --- PostgreSQL (NAS) ---
PG_HOST=192.168.4.22
PG_PORT=5433
PG_DB=fetch42
PG_USER=freshrss_user
PG_PASS="your_postgres_password"

# --- Web portal ---
WEB_HOST=0.0.0.0
WEB_PORT=8501

# --- Backups (scripts/backup_k13.sh, scripts/backup_postgres.sh) ---
DROPIT_DIR=/srv/dropit
