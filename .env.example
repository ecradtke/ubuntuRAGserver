# ==============================================================================
# K13 AI Stack (Ubuntu Server, native - no containers) - configuration template
# Copy to '.env' in the repo root (chmod 600) and fill in real values.
# This file is parsed (never executed) by the scripts in scripts/, so:
#   - put comments on their OWN line (no trailing "# comment" after a value)
#   - quote values that contain spaces or special characters: PG_PASS="my pass"
# ==============================================================================

# --- Network ---
NAS_HOST=192.168.4.22

# --- Data folders (created by scripts/install.sh) ---
K13_DATA_DIR=/var/lib/k13
# GGUF model files for llama.cpp
MODELS_DIR=/var/lib/k13/models
# OpenVINO embedding model (IR export + compile cache)
OV_MODELS_DIR=/var/lib/k13/openvino
QDRANT_STORAGE_DIR=/var/lib/k13/qdrant/storage
QDRANT_SNAPSHOTS_DIR=/var/lib/k13/qdrant/snapshots

# --- llama.cpp (chat LLM) ---
# Full path to your llama-server binary (find it with: command -v llama-server)
LLAMA_SERVER_BIN=/usr/local/bin/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
# Model file inside MODELS_DIR used until you switch models in the portal (blank = none yet)
LLAMA_MODEL=
# Context window in tokens (bigger = more memory)
LLAMA_CTX=16384
# Layers offloaded to the GPU (99 = everything that fits; lower it to split a big model between GPU and CPU)
LLAMA_GPU_LAYERS=99
# Extra llama-server flags, for example: --flash-attn on --threads 8
LLAMA_EXTRA_ARGS=
# Optional script sourced before llama-server starts (e.g. one that runs oneAPI setvars.sh for the SYCL backend)
LLAMA_PRE_SCRIPT=
# off = reasoning models (Qwen3) answer directly, on = allow hidden <think> reasoning
LLM_THINKING=off
MAX_NEW_TOKENS=2048

# --- OpenVINO embeddings (Intel NPU, CPU fallback) ---
# Python that has OpenVINO installed. Blank = create .venv-openvino inside this project
OPENVINO_PYTHON=
# Optional script sourced before the embedding server starts (e.g. /opt/intel/openvino/setupvars.sh)
OPENVINO_SETUPVARS=
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DEVICE=NPU
EMBED_HOST=127.0.0.1
EMBED_PORT=11434
HF_TOKEN=

# --- Qdrant (native binary) ---
QDRANT_PORT=6333
# 0.0.0.0 = reachable from your LAN (dashboard at http://<server>:6333/dashboard), 127.0.0.1 = this server only
QDRANT_BIND=0.0.0.0
QDRANT_COLLECTION=rss_articles

# --- FreshRSS API (NAS) ---
FRESHRSS_BASE_URL=http://192.168.4.22:9801
FRESHRSS_USER=your_freshrss_username
FRESHRSS_API_PASS="your_freshrss_api_password"

# --- PostgreSQL (NAS) ---
PG_HOST=192.168.4.22
PG_PORT=5433
PG_DB=fetch42
PG_USER=freshrss_user
PG_PASS="your_postgres_password"

# --- Web portal ---
WEB_HOST=0.0.0.0
WEB_PORT=8501

# --- Backups (scripts/backup_k13.sh, scripts/backup_postgres.sh) ---
DROPIT_DIR=/srv/dropit
