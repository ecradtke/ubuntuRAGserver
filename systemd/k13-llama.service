[Unit]
Description=K13 llama.cpp chat server (llama-server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=render video
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/run-llama-server.sh
Restart=on-failure
RestartSec=10
# exit 78 = no model selected / bad config: do not restart-loop
RestartPreventExitStatus=78
# loading a large model can take a while
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
