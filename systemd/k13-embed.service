[Unit]
Description=K13 OpenVINO embedding server (Intel NPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
# /dev/accel/accel0 (NPU) and /dev/dri (GPU) belong to these groups
SupplementaryGroups=render video
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/run-embed.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
